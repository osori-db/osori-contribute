{
  "name": "osori-contribute",
  "compatibility_date": "2025-12-01",
  // OpenNext 는 Next.js 서버를 workerd 위에서 돌리므로 Node 호환 계층이 필요하다.
  // /api/url-check 의 `export const runtime = 'nodejs'` 도 이 플래그에 기댄다.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "main": ".open-next/worker.js"
}
